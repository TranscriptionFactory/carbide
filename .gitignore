# Agent and editor local state
.claude/
.codex/
.cursor/
.gemini/
.iwe/
.ralph/
.serena/
.serena_home/
.vscode/
.design-engineer/
opencode.json
.mcp.json

# Environment and dependencies
.env
.venv/
node_modules
.pnpm-store/

# Build output and generated files
.svelte-kit
build/
dist/
src-tauri/gen/
src-tauri/target/
src-tauri/excalidraw-dist/
.eslintcache

# Local OS/cache files
.DS_Store
.tmpfiles
.ignore
.shiftlog/

# Private planning workspace — symlink to the carbide-private repo.
# This repo is public: never version control it or refer to it in PRs/issues.
# No trailing slash: git sees the symlink as a blob, so "private/" would not match.
private

# Sidecar binaries built or downloaded at build time
src-tauri/binaries/rumdl*
src-tauri/binaries/iwes*
src-tauri/binaries/carbide-cli*
!src-tauri/binaries/.gitkeep

# Nested vault/tool state produced by local documentation vaults
**/.carbide/.rumdl.toml
.worktrees/

# Taskplane runtime artifacts (machine-specific, do not commit)
.pi/batch-state.json
.pi/batch-history.json
.pi/lane-state-*
.pi/merge-result-*
.pi/merge-request-*
.pi/worker-conversation-*
.pi/orch-logs/
.pi/orch-abort-signal
.pi/settings.json
.taskplane-tasks/

# Pi project-local packages (if using pi install -l)
.pi/npm/

# Git bundles are backup artifacts and exceed GitHub's 100MB blob limit
*.bundle
